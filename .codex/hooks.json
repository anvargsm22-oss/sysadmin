{
  "description": "Generated by scripts/sync-codex.py: transport for shared Sysadmin guards",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/runtime/run-hook.sh\" red-zone",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); $taskRoot = git rev-parse --show-toplevel; & (Join-Path $taskRoot 'scripts/runtime/run-hook.ps1') -Hook 'red-zone'\"",
            "timeout": 30,
            "statusMessage": "Проверяю зону операции…"
          }
        ],
        "matcher": "(^|\\.)(Bash|exec_command|exec|write_stdin)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/runtime/run-hook.sh\" retro",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); $taskRoot = git rev-parse --show-toplevel; & (Join-Path $taskRoot 'scripts/runtime/run-hook.ps1') -Hook 'retro'\"",
            "timeout": 30,
            "statusMessage": "Проверяю основание находки…"
          }
        ],
        "matcher": "(^|\\.)(apply_patch|Write|Edit)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/runtime/run-hook.sh\" inventory",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); $taskRoot = git rev-parse --show-toplevel; & (Join-Path $taskRoot 'scripts/runtime/run-hook.ps1') -Hook 'inventory'\"",
            "timeout": 30,
            "statusMessage": "Сверяю inventory с изменениями…"
          }
        ]
      }
    ]
  }
}
