# Личная конфигурация агента — НИКОГДА не коммитится в публичный репо.
# Содержит реальные SSH-алиасы, домены, имя Telegram-бота оператора.
sysadmin-config.json

# Бэкапы личного конфига (создаются скиллами при изменениях) — содержат
# те же секреты, что и основной файл, ни в коем случае не в git.
sysadmin-config.json.bak.*
sysadmin-config.json.bak

# Публичные шаблоны и схема — коммитятся (negation override правила выше)
!sysadmin-config.example.json
!sysadmin-config.schema.json

# VPN-ссылки клиентов (vless://-URI, QR-PNG, links.txt) — секреты, эквивалент
# доступа к туннелю. Создаются скиллами /generate-client-config и подобными
# для передачи устройствам. Никогда не в git публичного репо.
.vpn-links-*/
.vpn-*.png
.vpn-*.txt

# Временные one-shot скрипты (отладочные/исследовательские),
# создаются в сессиях и не должны попадать в репо.
.tmp-*.py
.tmp-*.sh
.tmp-*.js

# Мусор macOS
.DS_Store
._*

# Редакторские
.vscode/
.idea/
*.swp

# Claude Code служебные файлы
.claude/scheduled_tasks.lock

# Метка последней проверки обновлений (у каждого оператора своя)
.update-check

# Результаты прогона evals — артефакты сессии, не часть репо.
# Раннер — scripts/run-evals.sh (см. ADR-0004).
.eval-results/

# Временные артефакты ревизий и audit-сессий (Explore-агенты,
# промежуточные отчёты) — не часть репо.
.audit-tmp/
